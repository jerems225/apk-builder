# Configuration du builder APK — /srv/apkbuild/.env
# Après toute modification :
#   sudo systemctl restart apkbuild-api apkbuild-web

# ── Réseau ───────────────────────────────────────────────────────────────────
# L'API et l'interface n'écoutent que sur la boucle locale : Apache est le seul
# point d'entrée public, et lui seul termine TLS.
PORT=9100
BIND_HOST=127.0.0.1
PUBLIC_URL=__PUBLIC_URL__
# Origine de l'interface. En production, identique à PUBLIC_URL (même vhost).
# En développement : http://localhost:3000
WEB_ORIGIN=__PUBLIC_URL__

# ── Secrets ──────────────────────────────────────────────────────────────────
# Clé maîtresse (32 octets hexadécimaux). Elle chiffre en AES-256-GCM :
#   - les jetons Git enregistrés dans l'écran Connexions,
#   - les mots de passe des magasins de clés de signature,
#   - les secrets de webhook de chaque espace de travail.
# Générer avec : openssl rand -hex 32
# ATTENTION : la remplacer rend illisibles tous les secrets déjà stockés.
# Les jetons Git devront être ressaisis, et les clés de signature redéposées.
ENCRYPTION_KEY=__ENCRYPTION_KEY__

# Compte créé au premier `npm run seed`. Laisser BOOTSTRAP_PASSWORD vide fait
# tirer un mot de passe au sort, affiché une seule fois dans la sortie du script.
BOOTSTRAP_EMAIL=__BOOTSTRAP_EMAIL__
BOOTSTRAP_PASSWORD=
BOOTSTRAP_WORKSPACE=Atelier

# Durée de vie d'une session d'interface, en heures.
SESSION_HOURS=12
# Mis à 1 automatiquement si PUBLIC_URL est en https. À forcer à false
# uniquement pour une mise au point en HTTP local.
# COOKIE_SECURE=true

# ── Migration depuis la version 1 ────────────────────────────────────────────
# Secret de l'ancienne route /webhook, sans espace dans l'URL. Conservé le temps
# que les webhooks déjà posés chez les clients migrent vers
# /api/webhooks/<espace>. Laisser vide une fois la migration terminée.
WEBHOOK_SECRET=__WEBHOOK_SECRET__
# Espace visé par cette ancienne route. Vide = le plus ancien.
LEGACY_WORKSPACE_SLUG=

# Jeton Git de repli, utilisé quand un projet n'a pas de connexion associée.
# Le moyen normal est l'écran « Connexions », qui chiffre le jeton en base.
GIT_TOKEN=

# ── Politique de build par défaut ────────────────────────────────────────────
# Ces valeurs ne servent que de gabarit à la création d'un projet : chaque
# projet porte ensuite ses propres réglages, modifiables dans l'interface.
BUILD_BRANCHES=main,master,develop
BUILD_TAGS=true

# assembleDebug produit un APK signé avec la clé de debug d'Android :
# installable en test, impubliable, et non installable par-dessus une version
# antérieure dès que le cache du serveur est vidé.
# assembleRelease EXIGE une clé de signature déposée sur le projet — sans elle,
# Android refuse l'APK (INSTALL_PARSE_FAILED_NO_CERTIFICATES).
GRADLE_TASK=assembleDebug
APP_SUBDIR=.

# Architectures natives passées à Gradle (-PreactNativeArchitectures).
# arm64-v8a seul couvre l'essentiel du parc et divise le poids de l'APK, mais
# exclut les téléphones 32 bits (d'avant 2015) et les émulateurs x86_64.
# Ignoré SILENCIEUSEMENT sous React Native 0.71 : le build réussit sans réduire.
ABIS=arm64-v8a

# ── Exécution ────────────────────────────────────────────────────────────────
DOCKER_IMAGE=rn-android-builder:1
# Plafond machine. 2 builds x 3 CPU / 8 Go laisse 2 coeurs et ~15 Go a Supabase
# et aux autres services. Ne pas augmenter sans verifier `free -h`.
# Chaque espace de travail a en plus son propre plafond, reglable dans
# l'interface : il empeche un client de monopoliser la file.
MAX_CONCURRENT=2
BUILD_CPUS=3
BUILD_MEMORY=8g
BUILD_TIMEOUT_MIN=45

# Chemin de keytool, utilisé pour valider un magasin de clés déposé dans
# l'interface. Vide = recherché dans le PATH.
KEYTOOL_BIN=keytool

# ── Rétention ────────────────────────────────────────────────────────────────
# Valeur par défaut, surchargeable espace par espace dans l'interface.
# 0 = conservation illimitée.
RETENTION_DAYS=30
